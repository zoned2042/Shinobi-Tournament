{
  "name": "shinobi-tournament",
  "version": "1.0.0",
  "private": true,
  "description": "Fantasy Shinobi Tournament: a single-file browser game with animated canvas fights.",
  "scripts": {
    "serve": "npx --yes http-server -c-1 -p 8080 .",
    "test": "node tests/smoke.js && node tests/meta.js",
    "test:smoke": "node tests/smoke.js",
    "test:meta": "node tests/meta.js",
    "test:moves": "node tests/moves.js all",
    "test:balance": "node tests/balance.js",
    "frames": "node tests/frames.js",
    "portraits": "node tests/portraits.js",
    "sounds": "node tests/sounds.js",
    "titles": "node tests/titles.js",
    "layout": "node tests/layout.js"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
